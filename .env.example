# Application Environment
APP_ENV=dev
LOG_LEVEL=INFO

# LiveKit Cloud Configuration
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Observability & Tracing (Langfuse)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Telephony (Telnyx SIP & Carrier Failover)
TELNYX_API_KEY=your_telnyx_api_key
TELNYX_PHONE_NUMBER=+15550001111
TELNYX_API_BASE_URL=https://api.telnyx.com/v2
CLINIC_FAILOVER_PHONE=+15551234567
SIP_TRUNK_ID=
# Prepended to bare 10-digit numbers when normalizing to E.164
DEFAULT_COUNTRY_CODE=+1

# LiveKit Inference Models (Routed via LiveKit Cloud)
STT_PROVIDER=deepgram
STT_MODEL=nova-3
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
TTS_PROVIDER=cartesia
TTS_MODEL=sonic-3
TTS_VOICE_ID=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc

# Silero VAD & Turn Tuning
VAD_MIN_SPEECH_DURATION=0.05
VAD_MIN_SILENCE_DURATION=0.40

# Clinic Operations & Booking (hours are 24h clinic-local time)
CLINIC_NAME="Dr. Smith's Clinic"
CLINIC_TIMEZONE=America/New_York
APPOINTMENT_DEFAULT_DURATION_MINUTES=30
CLINIC_OPEN_HOUR=9
CLINIC_CLOSE_HOUR=18
SLOT_INTERVAL_MINUTES=30
AFTERNOON_START_HOUR=12
EVENING_START_HOUR=16
# Days after a fully booked date to search when suggesting the closest openings
NEARBY_SEARCH_DAYS=3

# Integrations (mock, google, telnyx)
CALENDAR_BACKEND=mock
CALENDAR_API_KEY=
CALENDAR_ID=
SECRETS_MOUNT_DIR=/etc/secrets
SMS_BACKEND=mock
# Leave unset to use voice_assistant_bookings.db in the system temp directory
# BOOKINGS_DB_PATH=

# Timeouts (seconds) & Concurrency
STARTUP_CHECK_TIMEOUT=8.0
NUM_IDLE_PROCESSES=10
PROCESS_INIT_TIMEOUT=30.0
PARTICIPANT_WAIT_TIMEOUT=5.0
ROOM_SID_TIMEOUT=2.0
SMS_REQUEST_TIMEOUT=5.0
BOOKINGS_DB_TIMEOUT=10.0

# Guardrails Configuration
GUARDRAILS_ENABLED=true
GUARDRAILS_MAX_BOOKING_DAYS_AHEAD=60
GUARDRAILS_EMERGENCY_TRIAGE_ENABLED=true
GUARDRAILS_INJECTION_DEFENSE_ENABLED=true
GUARDRAILS_MEDICAL_ADVICE_ENABLED=true
GUARDRAILS_TTS_SANITIZER_ENABLED=true
